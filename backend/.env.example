# Google Books API Key（可选，建议配置以提高配额与稳定性）
GOOGLE_BOOKS_API_KEY=

# 非空库时允许匿名 bind 的管理口令（请求头 X-Setup-Token / 环境变量 SETUP_TOKEN）
# SETUP_TOKEN=

# 渠道头 HMAC 共享密钥（可选；配置后携带 X-Channel/X-External-User-Id 的请求必须附带
# X-Channel-Signature = HMAC-SHA256(secret, "{channel}:{external_user_id}") 十六进制。
# 网关代填头场景建议配置；CLI 侧用 BOOKSHELF_CHANNEL_SIGNING_SECRET 透传）
# CHANNEL_SIGNING_SECRET=

# 可信反向代理（可选，逗号分隔 IP/CIDR）。lwa/nginx 反代后 loopback 判定改信 X-Forwarded-For，
# 用于网关后从本机初始化 Owner 密码（见 docs/deployment.md「lwa 网关后初始化 Owner 密码」）
# TRUSTED_PROXIES=172.16.0.0/12

# ── 匿名共享书架（C 模式，权限阶段 1） ──
# 匿名目录策略：lan_shared=可信局域网可匿名浏览 L1 书目；disabled=只保留登录入口。
# 代码默认 disabled（存量部署升级不改变现状）；新部署建议开启并配置可信网段。
# ANONYMOUS_CATALOG_MODE=lan_shared  # 可选 explicit_public（B 模式：仅 public 标记的书匿名可见）
# 可信家庭局域网网段（逗号分隔 CIDR）。除回环外，只有来源可验证位于这些网段
# （或经 TRUSTED_PROXIES 还原后位于这些网段）才开放匿名 L1，否则自动降级为登录页。
# TRUSTED_LAN_CIDRS=192.168.1.0/24
# 匿名 Public Catalog 每客户端 IP 每分钟请求上限与单页最大条数
# PUBLIC_CATALOG_RATE_LIMIT_PER_MINUTE=60
# PUBLIC_CATALOG_MAX_PAGE_SIZE=50

# 数据目录与数据库（Docker / systemd 部署时使用绝对路径）
# DATA_DIR=/opt/home-bookshelf/data
# DATABASE_URL=sqlite:////opt/home-bookshelf/data/bookshelf.db

# 元数据 HTTP User-Agent
# METADATA_USER_AGENT=home-bookshelf/1.0

# ── MCP 只读试点（并行轨；默认关闭，显式配置启用） ──
# 路径固定 /mcp，只接受 Agent Bearer Token（books:read），仅两个只读工具
# （书目搜索/详情）。启用前必须：①创建专用只读 Grant（books:read，建议 30 天）；
# ②生成独立高熵游标密钥（不得复用其他密钥）。
# MCP_ENABLED=true
# MCP_ALLOWED_PROTOCOL_VERSIONS=2026-07-28
# MCP_MAX_PAGE_SIZE=20
# MCP_RATE_LIMIT_PER_MINUTE=60
# MCP 封面 Resource（默认关闭）
# MCP_COVER_RESOURCE_ENABLED=false
# MCP_CURSOR_SIGNING_SECRET=<独立高熵随机串，如 openssl rand -hex 32>
# 非回环部署必须显式配置 Host allowlist；浏览器客户端跨域时配置可信 Origin（精确匹配）
# MCP_ALLOWED_HOSTS=bookshelf.home
# MCP_TRUSTED_ORIGINS=https://bookshelf.home
# 可信网络部署档（CHK-077/BUG-214）：默认仅回环可信；家庭局域网试点须
# 显式配置 MCP 专用可信 CIDR（与匿名书架 TRUSTED_LAN_CIDRS 相互独立）
# MCP_TRUSTED_CIDRS=192.168.1.0/24,fd00::/8
# HTTPS 档（默认 true）：HTTP 仅限回环；局域网 HTTP 试点须 Owner 显式 false
# 且配置 MCP_TRUSTED_CIDRS；反代/网关档必须 HTTPS
# MCP_REQUIRE_HTTPS=true
# 传输硬上限（字节）：请求超限 413；响应超限防御性拒绝（默认 1MiB）
# MCP_MAX_REQUEST_BODY_BYTES=1048576
# MCP_MAX_RESPONSE_BODY_BYTES=1048576
