# 复制为 deploy/.env 后修改
# cp deploy/.env.example deploy/.env

# 监听地址（局域网访问改为 0.0.0.0:8000）
BOOKSHELF_BIND=127.0.0.1:8000

# 宿主机数据目录（相对 deploy/ 目录）
BOOKSHELF_DATA_DIR=../data

# 非空库时允许匿名 bind 的管理口令（请求头 X-Setup-Token / 环境变量 SETUP_TOKEN）
# SETUP_TOKEN=

# 渠道头 HMAC 共享密钥（可选；配置后渠道头必须附带 X-Channel-Signature 签名，防伪造）
# CHANNEL_SIGNING_SECRET=

# 可信反向代理（可选，逗号分隔 IP/CIDR；反代后 loopback 判定改信 X-Forwarded-For）
# TRUSTED_PROXIES=172.16.0.0/12

# Google Books API Key（可选）
GOOGLE_BOOKS_API_KEY=

# 元数据 User-Agent（可选）
# METADATA_USER_AGENT=home-bookshelf/1.0
