                                    },
                                    "properties": {
                                      "type": "object",
                                      "required": [
                                        "id", "title", "subtitle", "authors", "translators", "publisher",
                                        "publish_date", "edition", "language", "page_count", "category",
                                        "summary", "availability"
                                      ],
                                      "additionalProperties": false,
                                      "properties": {
                                        "id": {
                                          "type": "object",
                                          "required": ["type", "minimum"],
                                          "additionalProperties": false,
                                          "properties": {
                                            "type": { "const": "integer" },
                                            "minimum": { "const": 1 }
                                          }
                                        },
                                        "title": {
                                          "type": "object",
                                          "required": ["type"],
                                          "additionalProperties": false,
                                          "properties": { "type": { "const": "string" } }
                                        },
                                        "subtitle": {
                                          "type": "object",
                                          "required": ["type"],
                                          "additionalProperties": false,
                                          "properties": { "type": { "const": ["string", "null"] } }
                                        },
                                        "authors": {
                                          "type": "object",
                                          "required": ["type", "items"],
                                          "additionalProperties": false,
                                          "properties": {
                                            "type": { "const": "array" },
                                            "items": {
                                              "type": "object",
                                              "required": ["type"],
                                              "additionalProperties": false,
                                              "properties": { "type": { "const": "string" } }
                                            }
                                          }
                                        },
                                        "translators": {
                                          "type": "object",
                                          "required": ["type", "items"],
                                          "additionalProperties": false,
                                          "properties": {
                                            "type": { "const": "array" },
                                            "items": {
                                              "type": "object",
                                              "required": ["type"],
                                              "additionalProperties": false,
                                              "properties": { "type": { "const": "string" } }
                                            }
                                          }
                                        },
                                        "publisher": {
                                          "type": "object",
                                          "required": ["type"],
                                          "additionalProperties": false,
                                          "properties": { "type": { "const": ["string", "null"] } }
                                        },
                                        "publish_date": {
                                          "type": "object",
                                          "required": ["type"],
                                          "additionalProperties": false,
                                          "properties": { "type": { "const": ["string", "null"] } }
                                        },
                                        "edition": {
                                          "type": "object",
                                          "required": ["type"],
                                          "additionalProperties": false,
                                          "properties": { "type": { "const": ["string", "null"] } }
                                        },
                                        "language": {
                                          "type": "object",
                                          "required": ["type"],
                                          "additionalProperties": false,
                                          "properties": { "type": { "const": ["string", "null"] } }
                                        },
                                        "page_count": {
                                          "type": "object",
                                          "required": ["type"],
                                          "additionalProperties": false,
                                          "properties": { "type": { "const": ["integer", "null"] } }
                                        },
                                        "category": {
                                          "type": "object",
                                          "required": ["type"],
                                          "additionalProperties": false,
                                          "properties": { "type": { "const": ["string", "null"] } }
                                        },
                                        "summary": {
                                          "type": "object",
                                          "required": ["type"],
                                          "additionalProperties": false,
                                          "properties": { "type": { "const": ["string", "null"] } }
                                        },
                                        "availability": {
                                          "type": "object",
                                          "required": ["type", "enum"],
                                          "additionalProperties": false,
                                          "properties": {
                                            "type": { "const": "string" },
                                            "enum": { "const": ["in_shelf", "borrowed", "unknown"] }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            },
                            "count": {
                              "type": "object",
                              "required": ["type", "minimum"],
                              "additionalProperties": false,
                              "properties": {
