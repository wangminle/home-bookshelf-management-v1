                              "type": "object",
                              "required": ["type"],
                              "additionalProperties": false,
                              "properties": { "type": { "const": ["string", "null"] } }
                            }
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": ["type", "properties", "required", "additionalProperties"],
                      "additionalProperties": false,
                      "properties": {
                        "type": { "const": "object" },
                        "additionalProperties": { "const": false },
                        "required": { "const": ["items", "count", "has_more", "next_cursor"] },
                        "properties": {
                          "type": "object",
                          "required": ["items", "count", "has_more", "next_cursor"],
                          "additionalProperties": false,
                          "properties": {
                            "items": {
                              "type": "object",
                              "required": ["type", "items"],
                              "additionalProperties": false,
                              "properties": {
                                "type": { "const": "array" },
                                "items": {
                                  "type": "object",
                                  "required": ["type", "properties", "required", "additionalProperties"],
                                  "additionalProperties": false,
                                  "properties": {
                                    "type": { "const": "object" },
                                    "additionalProperties": { "const": false },
                                    "required": { "const": ["id", "title", "authors", "category", "availability"] },
                                    "properties": {
                                      "type": "object",
                                      "required": ["id", "title", "authors", "category", "availability"],
                                      "additionalProperties": false,
                                      "properties": {
                                        "id": {
                                          "type": "object",
                                          "required": ["type", "minimum"],
                                          "additionalProperties": false,
                                          "properties": {
                                            "type": { "const": "integer" },
                                            "minimum": { "const": 1 }
                                          }
                                        },
                                        "title": {
                                          "type": "object",
                                          "required": ["type"],
                                          "additionalProperties": false,
                                          "properties": { "type": { "const": "string" } }
                                        },
                                        "authors": {
                                          "type": "object",
                                          "required": ["type", "items"],
                                          "additionalProperties": false,
                                          "properties": {
                                            "type": { "const": "array" },
                                            "items": {
                                              "type": "object",
                                              "required": ["type"],
                                              "additionalProperties": false,
                                              "properties": { "type": { "const": "string" } }
                                            }
                                          }
                                        },
                                        "category": {
                                          "type": "object",
                                          "required": ["type"],
                                          "additionalProperties": false,
                                          "properties": { "type": { "const": ["string", "null"] } }
                                        },
                                        "availability": {
                                          "type": "object",
                                          "required": ["type", "enum"],
                                          "additionalProperties": false,
                                          "properties": {
                                            "type": { "const": "string" },
                                            "enum": { "const": ["in_shelf", "borrowed", "unknown"] }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            },
                            "count": {
                              "type": "object",
                              "required": ["type", "minimum"],
                              "additionalProperties": false,
                              "properties": {
                                "type": { "const": "integer" },
                                "minimum": { "const": 0 }
                              }
                            },
                            "has_more": {
                              "type": "object",
                              "required": ["type"],
                              "additionalProperties": false,
                              "properties": { "type": { "const": "boolean" } }
                            },
                            "next_cursor": {
                              "type": "object",
                              "required": ["type"],
                              "additionalProperties": false,
                              "properties": { "type": { "const": ["string", "null"] } }
                            }
                          }
                        }
                      }
                    }
                  ],
                  "items": false,
                  "description": "envelope 级 anyOf（BUG-231 深冻）：分支1=完整响应（13 字段全量）、分支2=摘要响应（恰 5 字段）；envelope 与 item 每层均冻结精确键集与字段 type/enum/minimum 常量。空结果合法；混用或混合形态在两分支都不通过。不用 oneOf，避免空 items=[] 被误拒。"
                }
              }
            }
          }
        },
        "bookshelf_get_book": {
          "type": "object",
          "required": ["name", "inputSchema", "outputSchema"],
          "properties": {
