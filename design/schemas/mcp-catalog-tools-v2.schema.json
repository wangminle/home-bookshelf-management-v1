{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "home_bookshelf MCP catalog tools v2 (summary/detail split)",
  "description": "OPT-010（Task 5.6 / CHK-095）：v2 契约版本化拆分搜索摘要与详情输出，降低 Agent 上下文与 Token 消耗。不新增工具名、不放宽隐私边界；v1（mcp-catalog-tools-v1.schema.json）保持冻结并继续作为默认发布契约，服务端通过 MCP_CONTRACT_VERSION=v2 显式发布本契约。本文件除清单外嵌入 tools/list 描述符的结构约束（descriptor_constraints），测试据此验证线上描述符与冻结契约一致（BUG-231）。",
  "type": "object",
  "required": ["tools", "contract_version", "descriptor_constraints"],
  "properties": {
    "tools": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["name", "description", "inputSchema", "outputSchema", "annotations"],
        "properties": {
          "name": { "enum": ["bookshelf_search_books", "bookshelf_get_book"] },
          "description": { "type": "string", "minLength": 1 },
          "inputSchema": { "type": "object" },
          "outputSchema": { "type": "object" },
          "annotations": {
            "type": "object",
            "required": ["readOnlyHint", "destructiveHint", "idempotentHint", "openWorldHint"],
            "properties": {
              "readOnlyHint": { "const": true },
              "destructiveHint": { "const": false },
              "idempotentHint": { "const": true },
              "openWorldHint": { "const": false }
            }
          }
        }
      }
    },
    "contract_version": {
      "const": "v2",
      "description": "discover 响应 result._meta['io.homebookshelf/contractVersion'] 必须为 v2 才代表本契约已发布"
    },
    "descriptor_constraints": {
      "type": "object",
      "description": "对线上 tools/list 描述符的冻结约束：以描述符为实例、本节为 Schema 验证（Draft 2020-12）。冻结粒度（BUG-231 深冻，CHK-107 收口）：不只冻分支数量与 required 外壳，还逐字段冻结 type/enum/minimum/maximum/maxLength 常量，并对每一层 properties 施加「全键 required + additionalProperties=false」的精确键集——保留外壳、掏空/放宽/增删字段定义的弱化描述符一律拒绝。search inputSchema 封闭且 anyOf 五分支冻结 required+非空白 pattern；outputSchema 为 envelope 级 anyOf 两分支（不用 oneOf：空 items=[] 会同时匹配两分支）。get 输入恰为 book_id，输出为 13 字段冻结集。",
      "properties": {
        "bookshelf_search_books": {
          "type": "object",
          "required": ["name", "inputSchema", "outputSchema"],
          "properties": {
            "name": { "const": "bookshelf_search_books" },
            "inputSchema": {
              "type": "object",
              "required": ["type", "properties", "required", "additionalProperties", "anyOf"],
              "additionalProperties": false,
              "properties": {
                "type": { "const": "object" },
                "required": { "const": [] },
                "additionalProperties": { "const": false },
                "properties": {
                  "type": "object",
                  "required": ["output", "query", "author", "category", "language", "availability", "limit", "cursor"],
                  "additionalProperties": false,
                  "properties": {
                    "output": {
                      "type": "object",
                      "required": ["type", "enum"],
                      "additionalProperties": false,
                      "properties": {
                        "type": { "const": "string" },
                        "enum": { "const": ["full", "summary"] }
                      }
                    },
                    "query": {
                      "type": "object",
                      "required": ["type", "maxLength"],
                      "additionalProperties": false,
                      "properties": {
                        "type": { "const": "string" },
                        "maxLength": { "const": 200 }
                      }
                    },
                    "author": {
                      "type": "object",
                      "required": ["type", "maxLength"],
                      "additionalProperties": false,
                      "properties": {
                        "type": { "const": "string" },
                        "maxLength": { "const": 100 }
                      }
                    },
                    "category": {
                      "type": "object",
                      "required": ["type", "maxLength"],
                      "additionalProperties": false,
                      "properties": {
                        "type": { "const": "string" },
                        "maxLength": { "const": 100 }
                      }
                    },
                    "language": {
                      "type": "object",
                      "required": ["type", "maxLength"],
                      "additionalProperties": false,
                      "properties": {
                        "type": { "const": "string" },
                        "maxLength": { "const": 20 }
                      }
                    },
                    "availability": {
                      "type": "object",
                      "required": ["type", "enum"],
                      "additionalProperties": false,
                      "properties": {
                        "type": { "const": "string" },
                        "enum": { "const": ["in_shelf", "borrowed", "unknown"] }
                      }
                    },
                    "limit": {
                      "type": "object",
                      "required": ["type", "minimum", "maximum"],
                      "additionalProperties": false,
                      "properties": {
                        "type": { "const": "integer" },
                        "minimum": { "const": 1 },
                        "maximum": { "const": 20 }
                      }
                    },
                    "cursor": {
                      "type": "object",
                      "required": ["type"],
                      "additionalProperties": false,
                      "properties": {
                        "type": { "const": "string" }
                      }
                    }
                  }
                },
                "anyOf": {
                  "type": "array",
                  "minItems": 5,
                  "maxItems": 5,
                  "prefixItems": [
                    {
                      "type": "object",
                      "required": ["required", "properties"],
                      "additionalProperties": false,
                      "properties": {
                        "required": { "const": ["query"] },
                        "properties": {
                          "type": "object",
                          "required": ["query"],
                          "additionalProperties": false,
                          "properties": {
                            "query": {
                              "type": "object",
                              "required": ["pattern"],
                              "additionalProperties": false,
                              "properties": { "pattern": { "const": "\\S" } }
                            }
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": ["required", "properties"],
                      "additionalProperties": false,
                      "properties": {
                        "required": { "const": ["author"] },
                        "properties": {
                          "type": "object",
                          "required": ["author"],
                          "additionalProperties": false,
                          "properties": {
                            "author": {
                              "type": "object",
                              "required": ["pattern"],
                              "additionalProperties": false,
                              "properties": { "pattern": { "const": "\\S" } }
                            }
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": ["required", "properties"],
                      "additionalProperties": false,
                      "properties": {
                        "required": { "const": ["category"] },
                        "properties": {
                          "type": "object",
                          "required": ["category"],
                          "additionalProperties": false,
                          "properties": {
                            "category": {
                              "type": "object",
                              "required": ["pattern"],
                              "additionalProperties": false,
                              "properties": { "pattern": { "const": "\\S" } }
                            }
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": ["required", "properties"],
                      "additionalProperties": false,
                      "properties": {
                        "required": { "const": ["language"] },
                        "properties": {
                          "type": "object",
                          "required": ["language"],
                          "additionalProperties": false,
                          "properties": {
                            "language": {
                              "type": "object",
                              "required": ["pattern"],
                              "additionalProperties": false,
                              "properties": { "pattern": { "const": "\\S" } }
                            }
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": ["required"],
                      "additionalProperties": false,
                      "properties": {
                        "required": { "const": ["availability"] }
                      }
                    }
                  ],
                  "items": false,
                  "description": "前四分支为字符串筛选字段的 required+非空白 pattern（BUG-232），末分支为 availability required；每分支键集与 pattern 值均冻结，空对象分支必须失败"
                }
              }
            },
            "outputSchema": {
              "type": "object",
              "required": ["anyOf"],
              "additionalProperties": false,
              "properties": {
                "anyOf": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "prefixItems": [
                    {
                      "type": "object",
                      "required": ["type", "properties", "required", "additionalProperties"],
                      "additionalProperties": false,
                      "properties": {
                        "type": { "const": "object" },
                        "additionalProperties": { "const": false },
                        "required": { "const": ["items", "count", "has_more", "next_cursor"] },
                        "properties": {
                          "type": "object",
                          "required": ["items", "count", "has_more", "next_cursor"],
                          "additionalProperties": false,
                          "properties": {
                            "items": {
                              "type": "object",
                              "required": ["type", "items"],
                              "additionalProperties": false,
                              "properties": {
                                "type": { "const": "array" },
                                "items": {
